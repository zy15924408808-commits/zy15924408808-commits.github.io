---
import BaseLayout from '../layouts/BaseLayout.astro';
import CircuitBoard from '../components/CircuitBoard.astro';
import ProjectArtwork from '../components/ProjectArtwork.astro';
import { site, about } from '../config';
import { getCollection } from 'astro:content';
import { postUrl, fmtDate } from '../utils/blog';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const skills = [...new Set(about.skills.flatMap(group => group.items))].slice(0, 8);
---

<BaseLayout>
  <section class="home-hero">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="site-container hero-layout">
      <div class="hero-copy">
        <p class="eyebrow" data-reveal><span class="status-dot"></span> PERSONAL SPACE / {site.name.toUpperCase()}</p>
        <h1 data-reveal>你好，我是 <span class="hero-name">{site.name}<span class="terminal-cursor" aria-hidden="true">_</span></span></h1>
        <p class="hero-tagline" data-reveal>{site.tagline}</p>
        <p class="hero-description" data-reveal>{site.intro}</p>
        <div class="hero-actions" data-reveal>
          <a href="/projects" class="button button-primary">探索项目 <span aria-hidden="true">↗</span></a>
          <a href="/blog" class="button button-secondary">阅读笔记 <span aria-hidden="true">→</span></a>
        </div>
        <div class="hero-social" data-reveal>
          <span class="social-caption">在这里找到我</span>
          {site.social.github && <a href={site.social.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>}
          {site.social.bilibili && <a href={site.social.bilibili} target="_blank" rel="noopener noreferrer">Bilibili <span aria-hidden="true">↗</span></a>}
          {site.email && <a href={`mailto:${site.email}`}>Email <span aria-hidden="true">↗</span></a>}
        </div>
      </div>
      <div class="hero-visual" data-reveal><CircuitBoard /></div>
      <div class="hero-bottom" data-reveal>
        <p><span class="tiny-cross" aria-hidden="true">+</span> 把想法写进代码，让代码连接现实。</p>
        <a href="#explore" class="scroll-cue">继续探索 <span aria-hidden="true">↓</span></a>
      </div>
    </div>
  </section>

  <div class="skill-ribbon">
    <div class="site-container skill-ribbon-inner">
      <span class="ribbon-label">LEARNING & BUILDING</span>
      <div class="ribbon-skills">{skills.map(skill => <span>{skill}</span>)}</div>
    </div>
  </div>

  <section id="explore" class="site-container home-section">
    <div class="section-heading" data-reveal>
      <div><p class="eyebrow">01 / SELECTED WORK</p><h2>从想法，到作品<span class="heading-dot">.</span></h2></div>
      <a href="/projects" class="text-link">全部项目 <span aria-hidden="true">↗</span></a>
    </div>
    {projects.length > 0 ? (
      <div class="home-projects">
        {projects.slice(0, 2).map((project, i) => (
          <a href={`/projects/${project.slug}`} class="card project-preview" data-reveal>
            <ProjectArtwork title={project.data.title} image={project.data.image} stack={project.data.stack} index={i} />
            <div class="project-preview-body">
              <div class="project-meta"><span>PROJECT / {String(i + 1).padStart(2, '0')}</span><span aria-hidden="true">⌁</span></div>
              <h3>{project.data.title}</h3>
              <p>{project.data.description}</p>
              <div class="tag-list">{project.data.stack.slice(0, 5).map(skill => <span class="tech-tag">{skill}</span>)}</div>
            </div>
          </a>
        ))}
      </div>
    ) : <a class="card empty-project" data-reveal href="/projects"><span class="eyebrow">WORK IN PROGRESS</span><h3>项目正在积累中</h3><p>记录每一次实践，让想法慢慢成形。<span aria-hidden="true">↗</span></p></a>}
  </section>

  <section class="site-container home-section notes-section">
    <div class="section-heading" data-reveal>
      <div><p class="eyebrow">02 / FIELD NOTES</p><h2>记录每一次探索<span class="heading-dot">.</span></h2></div>
      <a href="/blog" class="text-link">全部文章 <span aria-hidden="true">↗</span></a>
    </div>
    <div class="home-notes">
      <div class="notes-aside" data-reveal>
        <span class="notes-symbol" aria-hidden="true">&lt;/&gt;</span>
        <h3>边学习，边记录。</h3>
        <p>技术笔记、调试过程，以及那些终于想明白的瞬间。</p>
        <div class="notes-count"><strong>{String(posts.length).padStart(2, '0')}</strong><span>篇公开笔记</span></div>
        <div class="notes-browse"><a href="/categories">按分类浏览 ↗</a><a href="/tags">探索标签 ↗</a></div>
      </div>
      <div class="notes-list">
        {posts.slice(0, 4).map((post, i) => (
          <a href={postUrl(post)} class="note-row" data-reveal>
            <span class="note-index">{String(i + 1).padStart(2, '0')}</span>
            <div class="note-copy"><p class="note-meta"><time datetime={post.data.date.toISOString()}>{fmtDate(post.data.date)}</time>{post.data.tags[0] && <span>{post.data.tags[0]}</span>}</p><h3>{post.data.title}</h3>{post.data.description && <p class="note-description">{post.data.description}</p>}</div>
            <span class="note-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
        {posts.length === 0 && <p class="empty-notes">下一篇笔记，正在路上。</p>}
      </div>
    </div>
  </section>

  <section class="site-container home-section">
    <div class="about-banner" data-reveal>
      <div><p class="eyebrow">03 / BEHIND THE CODE</p><h2>保持好奇，持续构建。</h2><p>关于我的学习、技能，以及一路走来的故事。</p></div>
      <a href="/about" class="button button-secondary">认识一下 <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
