---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config';
import { getCollection } from 'astro:content';
import { postUrl, fmtDate } from '../utils/blog';

// 获取统计数据
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const allProjects = await getCollection('projects');

// 获取所有分类和标签
const categories = [...new Set(allPosts.map(p => p.data.category))];
const allTags = allPosts.flatMap(p => p.data.tags || []);
const tags = [...new Set(allTags)];
---

<BaseLayout>
  <!-- Hero -->
  <section class="grid-bg relative border-b border-line">
    <div class="mx-auto max-w-5xl px-6 py-28 sm:py-36">
      <p class="font-mono text-sm text-accent mb-4">$ wind</p>
      <h1 class="text-4xl sm:text-6xl font-bold leading-tight">
        你好，我是 <span class="text-gradient">{site.name}</span>
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-ink-dim leading-relaxed">
        {site.intro}
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href="/projects"
          class="rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-bg shadow-glow hover:bg-accent-glow transition-colors"
        >
          项目合集
        </a>
        <a
          href="/blog"
          class="rounded-lg border border-line px-5 py-2.5 text-sm font-semibold text-ink hover:border-accent/50 hover:text-accent transition-colors"
        >
          博客笔记
        </a>
      </div>

      <!-- 社交链接 -->
      <div class="mt-8 flex items-center gap-4">
        {site.social.github && (
          <a
            href={site.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="text-ink-dim hover:text-accent transition-colors"
            aria-label="GitHub"
          >
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>
        )}
        {site.social.bilibili && (
          <a
            href={site.social.bilibili}
            target="_blank"
            rel="noopener noreferrer"
            class="text-ink-dim hover:text-accent transition-colors"
            aria-label="Bilibili"
          >
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.813 4.653h.854c1.51.054 2.769.578 3.773 1.574 1.004.995 1.524 2.249 1.56 3.76v7.36c-.036 1.51-.556 2.769-1.56 3.773s-2.262 1.524-3.773 1.56H5.333c-1.51-.036-2.769-.556-3.773-1.56S.036 18.858 0 17.347v-7.36c.036-1.511.556-2.765 1.56-3.76 1.004-.996 2.262-1.52 3.773-1.574h.774l-1.174-1.12a1.234 1.234 0 0 1-.373-.906c0-.356.124-.658.373-.907l.027-.027c.267-.249.573-.373.92-.373.347 0 .653.124.92.373L9.653 4.44c.071.071.134.142.187.213h4.267a.836.836 0 0 1 .16-.213l2.853-2.747c.267-.249.573-.373.92-.373.347 0 .662.151.929.4.267.249.391.551.391.907 0 .355-.124.657-.373.906zM5.333 7.24c-.746.018-1.373.276-1.88.773-.506.498-.769 1.13-.786 1.894v7.52c.017.764.28 1.395.786 1.893.507.498 1.134.756 1.88.773h13.334c.746-.017 1.373-.275 1.88-.773.506-.498.769-1.129.786-1.893v-7.52c-.017-.765-.28-1.396-.786-1.894-.507-.497-1.134-.755-1.88-.773zM8 11.107c.373 0 .684.124.933.373.25.249.383.569.4.96v1.173c-.017.391-.15.711-.4.96-.249.25-.56.374-.933.374s-.684-.125-.933-.374c-.25-.249-.383-.569-.4-.96V12.44c0-.373.129-.689.386-.947.258-.257.574-.386.947-.386zm8 0c.373 0 .684.124.933.373.25.249.383.569.4.96v1.173c-.017.391-.15.711-.4.96-.249.25-.56.374-.933.374s-.684-.125-.933-.374c-.25-.249-.383-.569-.4-.96V12.44c.017-.391.15-.711.4-.96.249-.249.56-.373.933-.373Z"/>
            </svg>
          </a>
        )}
        {site.email && (
          <a
            href={`mailto:${site.email}`}
            class="text-ink-dim hover:text-accent transition-colors"
            aria-label="Email"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </a>
        )}
      </div>
    </div>
  </section>

  <!-- 网站目录 -->
  <section class="mx-auto max-w-5xl px-6 py-16">
    <div class="mb-8">
      <h2 class="text-2xl font-bold">
        <span class="font-mono text-accent text-base mr-2">#</span>网站目录
      </h2>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <!-- 博客文章 -->
      <a href="/blog" class="card p-6 group hover:border-accent/50 transition-colors">
        <div class="flex items-center gap-3 mb-3">
          <span class="text-2xl">📝</span>
          <h3 class="text-lg font-semibold text-ink group-hover:text-accent transition-colors">博客文章</h3>
        </div>
        <p class="text-sm text-ink-dim mb-3">技术笔记与学习总结</p>
        <span class="font-mono text-xs text-accent">{allPosts.length} 篇文章</span>
      </a>

      <!-- 项目展示 -->
      <a href="/projects" class="card p-6 group hover:border-accent/50 transition-colors">
        <div class="flex items-center gap-3 mb-3">
          <span class="text-2xl">🚀</span>
          <h3 class="text-lg font-semibold text-ink group-hover:text-accent transition-colors">项目展示</h3>
        </div>
        <p class="text-sm text-ink-dim mb-3">个人项目与作品集</p>
        <span class="font-mono text-xs text-accent">{allProjects.length} 个项目</span>
      </a>

      <!-- 文章分类 -->
      <a href="/categories" class="card p-6 group hover:border-accent/50 transition-colors">
        <div class="flex items-center gap-3 mb-3">
          <span class="text-2xl">📂</span>
          <h3 class="text-lg font-semibold text-ink group-hover:text-accent transition-colors">文章分类</h3>
        </div>
        <p class="text-sm text-ink-dim mb-3">按主题浏览文章</p>
        <span class="font-mono text-xs text-accent">{categories.length} 个分类</span>
      </a>

      <!-- 标签云 -->
      <a href="/tags" class="card p-6 group hover:border-accent/50 transition-colors">
        <div class="flex items-center gap-3 mb-3">
          <span class="text-2xl">🏷️</span>
          <h3 class="text-lg font-semibold text-ink group-hover:text-accent transition-colors">标签云</h3>
        </div>
        <p class="text-sm text-ink-dim mb-3">通过标签查找内容</p>
        <span class="font-mono text-xs text-accent">{tags.length} 个标签</span>
      </a>

      <!-- 关于我 -->
      <a href="/about" class="card p-6 group hover:border-accent/50 transition-colors">
        <div class="flex items-center gap-3 mb-3">
          <span class="text-2xl">👤</span>
          <h3 class="text-lg font-semibold text-ink group-hover:text-accent transition-colors">关于我</h3>
        </div>
        <p class="text-sm text-ink-dim mb-3">个人介绍与获奖经历</p>
        <span class="font-mono text-xs text-accent">了解更多 →</span>
      </a>

      <!-- 联系方式 -->
      <a href="/contact" class="card p-6 group hover:border-accent/50 transition-colors">
        <div class="flex items-center gap-3 mb-3">
          <span class="text-2xl">✉️</span>
          <h3 class="text-lg font-semibold text-ink group-hover:text-accent transition-colors">联系我</h3>
        </div>
        <p class="text-sm text-ink-dim mb-3">获取联系方式</p>
        <span class="font-mono text-xs text-accent">保持联系 →</span>
      </a>
    </div>
  </section>
</BaseLayout>
