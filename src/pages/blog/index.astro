---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { postUrl, fmtDate, groupByCategory } from '../../utils/blog';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// 按分类（文件夹）分组
const categories = groupByCategory(posts);
---

<BaseLayout title="博客" description="我的学习笔记与思考。">
  <section class="mx-auto max-w-3xl px-6 py-16 writing-page">
    <div class="page-intro" data-reveal>
      <p class="eyebrow">THE NOTEBOOK / {String(posts.length).padStart(2, '0')} ENTRIES</p>
      <h1>学习，思考，记录<span class="heading-dot">.</span></h1>
      <p>记录技术的细节，也记录成长的轨迹。</p>
      <div class="archive-links"><a href="/categories">按分类浏览 ↗</a><a href="/tags">探索标签 ↗</a></div>
    </div>

    {posts.length === 0 ? (
      <p class="text-ink-dim">还没有文章,尽情创作吧！</p>
    ) : (
      categories.map(([cat, catPosts]) => (
        <div class="blog-group" data-reveal>
          <a href={`/categories/${cat}`} class="group inline-flex items-center gap-2 mb-4">
            <span class="font-mono text-accent">▸</span>
            <h2 class="text-lg font-semibold text-ink group-hover:text-accent transition-colors">{cat}</h2>
            <span class="text-xs text-ink-faint">{catPosts.length}</span>
          </a>
          <ul class="blog-entry-list divide-y divide-line">
            {catPosts.map((post) => (
              <li>
                <a href={postUrl(post)} class="group block py-4">
                  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                    <span class="text-ink group-hover:text-accent transition-colors font-medium">{post.data.title}</span>
                    <span class="font-mono text-xs text-ink-faint whitespace-nowrap">{fmtDate(post.data.date)}</span>
                  </div>
                  {post.data.description && (
                    <p class="mt-1 text-sm text-ink-dim leading-relaxed">{post.data.description}</p>
                  )}
                  {post.data.tags.length > 0 && (
                    <div class="mt-2 flex flex-wrap gap-2">
                      {post.data.tags.map((t) => (
                        <span class="font-mono text-[11px] text-ink-faint">#{t}</span>
                      ))}
                    </div>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    )}
  </section>
</BaseLayout>
