---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectArtwork from '../../components/ProjectArtwork.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout title="项目" description="我做过的嵌入式项目与作品。">
  <section class="site-container py-16">
    <div class="page-intro" data-reveal>
      <p class="eyebrow">THE PROJECT ARCHIVE / {String(projects.length).padStart(2, '0')}</p>
      <h1>把想法，变成现实<span class="heading-dot">.</span></h1>
      <p>从一盏 LED 到一个完整系统，记录每一次动手实践。</p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2">
      {projects.map((p, i) => (
        <article id={p.slug} class="card overflow-hidden flex flex-col scroll-mt-24">
          <a href={`/projects/${p.slug}`} aria-label={`查看项目：${p.data.title}`}><ProjectArtwork title={p.data.title} image={p.data.image} stack={p.data.stack} index={i} /></a>
          <div class="p-6 flex flex-col flex-1">
            <h2 class="text-xl font-semibold text-ink">{p.data.title}</h2>
            <p class="mt-2 text-sm text-ink-dim leading-relaxed flex-1">{p.data.description}</p>

            <div class="mt-4 flex flex-wrap gap-2">
              {p.data.stack.map((s) => (
                <span class="font-mono text-xs text-accent/80 bg-accent/5 border border-accent/20 rounded px-2 py-0.5">{s}</span>
              ))}
            </div>

            <div class="mt-5 flex items-center gap-4 text-sm">
              <a href={`/projects/${p.slug}`} class="text-accent hover:underline underline-offset-4">查看详情 →</a>
              {p.data.repo && (
                <a href={p.data.repo} target="_blank" rel="noopener noreferrer" class="text-ink-dim hover:text-accent transition-colors">代码仓库</a>
              )}
              {p.data.link && (
                <a href={p.data.link} target="_blank" rel="noopener noreferrer" class="text-ink-dim hover:text-accent transition-colors">演示</a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
    {projects.length === 0 && <p class="empty-notes">项目正在积累中，新的作品即将到来。</p>}
  </section>
</BaseLayout>
