---
import { nav, site } from '../config';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-line bg-bg/80 backdrop-blur-md">
  <nav class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
    <a href="/" class="group flex items-center gap-2 font-mono text-sm font-semibold">
      <span class="text-accent">&gt;_</span>
      <span class="text-ink group-hover:text-accent transition-colors">{site.name}</span>
    </a>

    <!-- 桌面端导航 -->
    <ul class="hidden md:flex items-center gap-1 text-sm">
      {nav.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              'rounded-md px-3 py-1.5 transition-colors',
              isActive(item.href)
                ? 'text-accent bg-accent/10'
                : 'text-ink-dim hover:text-ink hover:bg-bg-soft',
            ]}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- 移动端汉堡按钮 -->
    <button
      id="mobile-menu-btn"
      class="md:hidden text-ink hover:text-accent transition-colors"
      aria-label="Toggle menu"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>
  </nav>

  <!-- 移动端菜单 -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-line bg-bg/95 backdrop-blur-md">
    <ul class="mx-auto max-w-5xl px-6 py-4 space-y-1">
      {nav.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              'block rounded-md px-3 py-2 transition-colors',
              isActive(item.href)
                ? 'text-accent bg-accent/10'
                : 'text-ink-dim hover:text-ink hover:bg-bg-soft',
            ]}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });

  // 点击菜单项后关闭菜单
  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
    });
  });
</script>
