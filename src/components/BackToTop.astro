<!-- 返回顶部按钮 -->
<button
  id="back-to-top"
  class="fixed bottom-8 right-8 z-40 opacity-0 pointer-events-none transition-opacity duration-300 rounded-lg bg-accent p-3 text-bg shadow-glow hover:bg-accent-glow"
  aria-label="返回顶部"
>
  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/>
  </svg>
</button>

<script>
  let cleanupScroll: (() => void) | undefined;
  document.addEventListener('astro:page-load', () => {
    cleanupScroll?.();
    const btn = document.getElementById('back-to-top');
    const update = () => {
      const visible = window.scrollY > 300;
      btn?.classList.toggle('opacity-0', !visible);
      btn?.classList.toggle('pointer-events-none', !visible);
      btn?.classList.toggle('opacity-100', visible);
      btn?.setAttribute('tabindex', visible ? '0' : '-1');
    };
    window.addEventListener('scroll', update, { passive: true });
    cleanupScroll = () => window.removeEventListener('scroll', update);
    update();
    btn?.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'
      });
    });
  });
  document.addEventListener('astro:before-swap', () => cleanupScroll?.());
</script>
