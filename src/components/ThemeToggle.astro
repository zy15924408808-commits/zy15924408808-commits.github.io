<button
  id="theme-toggle"
  class="rounded-md p-2 text-ink-dim hover:text-ink hover:bg-bg-soft transition-colors"
  aria-label="切换主题"
  title="切换深色/浅色模式"
>
  <svg id="theme-icon-light" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
  </svg>
  <svg id="theme-icon-dark" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
  </svg>
</button>

<script>
  function updateIcon() {
    const isLight = document.documentElement.classList.contains('light');
    document.getElementById('theme-icon-light')?.classList.toggle('hidden', !isLight);
    document.getElementById('theme-icon-dark')?.classList.toggle('hidden', isLight);
  }

  function bindToggle() {
    updateIcon();
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const isLight = document.documentElement.classList.toggle('light');
      localStorage.setItem('theme', isLight ? 'light' : 'dark');
      updateIcon();
    });
  }

  // 首次加载和每次页面导航后都重新绑定
  bindToggle();
  document.addEventListener('astro:after-swap', bindToggle);
</script>
